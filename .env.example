# LLM container settings
LLM_API_BASE_URL=http://llm:8080
LLM_MODEL=local-model
LLM_MODEL_PATH=/models/model.gguf
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_CONTEXT_SIZE=2048
LLM_THREADS=4

# STT container settings
STT_API_BASE_URL=http://stt:9000
STT_MODEL_PATH=/models/ggml-medium.bin
STT_LANGUAGE=ja
STT_THREADS=4
STT_TIMEOUT_SECONDS=180

# API settings
API_CORS_ORIGINS=http://localhost:5173
RAG_ENABLED=true
RAG_DOCUMENTS_DIR=/knowledge
RAG_UPLOADS_DIR=/rag-uploads
RAG_DB_DIR=/rag-data
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=3
